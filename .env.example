# Punarnava local Build It configuration. Copy to .env (optional: every value below is the default).
# No AWS account, card or real credentials are needed or used.

# Local server (backend/src/local/server.js)
PN_HOST=127.0.0.1
PN_PORT=8787
PN_DATA_DIR=.local-data            # records, workflow state, uploaded photos and voice notes, signing secret
PN_PERSONAS=true                   # "Try as" persona sign-in for demos (turn off to require email/password accounts)
PN_DEV_TOOLS=true                  # Reset / Skip 30 min buttons (loopback only)
PN_DEMO_TIMERS=true                # owner reminder 2 min, 30-day follow-up 5 min, so they show up in a demo
PN_SEED_SYNTHETIC=6000             # labelled synthetic repairs loaded on first start (0 = none)
# PN_SESSION_SECRET=               # leave empty: a random secret is created in PN_DATA_DIR/secret

# Storage: file (durable JSON + files on disk, default) | localstack (DynamoDB + S3 in LocalStack)
PN_STORE=file
PN_FILES=disk
LOCALSTACK_URL=http://127.0.0.1:4566
PN_TABLE=punarnava-local
PN_BUCKET=punarnava-local
AWS_REGION=ap-south-1
# LocalStack accepts any credentials; these are dummies, never real keys.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Authorization: cedar (policies/punarnava.cedar, required for the full demo) | routes (route role checks only)
PN_AUTHZ=cedar

# Search: opensearch (falls back to the store when OpenSearch is down) | off
PN_SEARCH=opensearch
OPENSEARCH_URL=http://127.0.0.1:9200

# Assistant: strands (local Strands Agents service in agent/, rule-based fallback) | off
PN_AGENT=strands
AGENT_URL=http://127.0.0.1:8790
AGENT_TIMEOUT_MS=25000
# Agent service (agent/service.py): a local model through Ollama. Nothing paid or hosted.
AGENT_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
AGENT_MODEL=llama3.1:8b
