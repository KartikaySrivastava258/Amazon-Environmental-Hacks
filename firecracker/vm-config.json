{
  "boot-source": {
    "kernel_image_path": "KERNEL_PATH",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off ip=172.16.0.2::172.16.0.1:255.255.255.252::eth0:off init=/sbin/pn-init"
  },
  "drives": [
    { "drive_id": "rootfs", "path_on_host": "firecracker/rootfs.ext4", "is_root_device": true, "is_read_only": false }
  ],
  "machine-config": { "vcpu_count": 2, "mem_size_mib": 2048 },
  "network-interfaces": [
    { "iface_id": "eth0", "guest_mac": "06:00:AC:10:00:02", "host_dev_name": "tap0" }
  ]
}
