// Punarnava authorization policy (Cedar). GENERATED by scripts/local/gen-cedar.mjs from the API route table;
// edit the generator, not this file. Deny by default: an action that no permit below covers is refused.
//
// Principal: Punarnava::User::"<userId>" in Punarnava::Role::"<role>" and Punarnava::Role::"member";
//            anonymous visitors are Punarnava::User::"anonymous" in Punarnava::Role::"public".
// Attributes: status ("active" | "pending" | "suspended" | "anonymous"), role, brandId, orgType.
// Action:    Punarnava::Action::"<METHOD> <route pattern>".  Resource: Punarnava::Api::"punarnava".
// Context:   brand (the brand a request names, or "").
// Ownership checks on individual records (my job, my pickup, owner tokens) stay in backend/src/core.
@id("public")
permit (
  principal,
  action in [
    Punarnava::Action::"GET /public/catalog",
    Punarnava::Action::"GET /public/impact",
    Punarnava::Action::"GET /public/passport/:pid",
    Punarnava::Action::"GET /public/owner/:jobId",
    Punarnava::Action::"POST /public/owner/:jobId/decision",
    Punarnava::Action::"POST /public/owner/:jobId/confirm",
    Punarnava::Action::"POST /public/owner/:jobId/followup",
    Punarnava::Action::"POST /public/owner/:jobId/green",
    Punarnava::Action::"GET /public/market",
    Punarnava::Action::"GET /public/market/:id",
    Punarnava::Action::"POST /public/market/:id/interest",
    Punarnava::Action::"GET /public/scores",
    Punarnava::Action::"GET /public/rates",
    Punarnava::Action::"POST /public/tts",
    Punarnava::Action::"POST /public/owner/:jobId/uploads",
    Punarnava::Action::"POST /public/owner/:jobId/stt",
    Punarnava::Action::"GET /public/owner/:jobId/stt/:jobName",
    Punarnava::Action::"GET /public/rewards/rules",
    Punarnava::Action::"POST /public/requests/match",
    Punarnava::Action::"POST /public/requests/uploads",
    Punarnava::Action::"POST /public/requests",
    Punarnava::Action::"GET /public/requests/:id",
    Punarnava::Action::"POST /public/requests/:id/cancel",
    Punarnava::Action::"GET /public/green/:cid",
    Punarnava::Action::"POST /public/green/:cid/read",
    Punarnava::Action::"GET /public/search"
  ],
  resource
);

@id("member-self")
permit (
  principal in Punarnava::Role::"member",
  action in [
    Punarnava::Action::"GET /api/me",
    Punarnava::Action::"PUT /api/me",
    Punarnava::Action::"GET /api/notifications",
    Punarnava::Action::"POST /api/notifications/read"
  ],
  resource
);

@id("member-active")
permit (
  principal in Punarnava::Role::"member",
  action in [
    Punarnava::Action::"POST /api/uploads",
    Punarnava::Action::"GET /api/recyclers",
    Punarnava::Action::"POST /api/tts",
    Punarnava::Action::"POST /api/stt/uploads",
    Punarnava::Action::"POST /api/stt",
    Punarnava::Action::"GET /api/stt/:jobName"
  ],
  resource
)
when { principal.status == "active" };

@id("role-technician")
permit (
  principal in Punarnava::Role::"technician",
  action in [
    Punarnava::Action::"GET /api/jobs",
    Punarnava::Action::"POST /api/jobs",
    Punarnava::Action::"POST /api/jobs/:id/continue",
    Punarnava::Action::"GET /api/jobs/:id",
    Punarnava::Action::"POST /api/jobs/:id/diagnosis",
    Punarnava::Action::"POST /api/jobs/:id/complete",
    Punarnava::Action::"GET /api/inventory",
    Punarnava::Action::"POST /api/passports/:pid/harvest",
    Punarnava::Action::"POST /api/passports/:pid/transfer",
    Punarnava::Action::"POST /api/passports/:pid/recycle",
    Punarnava::Action::"GET /api/parts/search",
    Punarnava::Action::"GET /api/parts/mine",
    Punarnava::Action::"POST /api/parts/:id/reserve",
    Punarnava::Action::"POST /api/parts/:id/handover",
    Punarnava::Action::"POST /api/parts/:id/release",
    Punarnava::Action::"GET /api/searches",
    Punarnava::Action::"POST /api/searches",
    Punarnava::Action::"DELETE /api/searches/:id",
    Punarnava::Action::"GET /api/pickups/requested",
    Punarnava::Action::"GET /api/requests",
    Punarnava::Action::"GET /api/requests/:id",
    Punarnava::Action::"POST /api/requests/:id/accept",
    Punarnava::Action::"POST /api/requests/:id/decline",
    Punarnava::Action::"POST /api/requests/:id/job",
    Punarnava::Action::"GET /api/search",
    Punarnava::Action::"POST /api/assist/diagnosis",
    Punarnava::Action::"POST /api/assist/recommendation"
  ],
  resource
)
when { principal.status == "active" };

@id("role-collector")
permit (
  principal in Punarnava::Role::"collector",
  action in [
    Punarnava::Action::"GET /api/pickups/open",
    Punarnava::Action::"GET /api/pickups/mine",
    Punarnava::Action::"POST /api/pickups/:id/accept",
    Punarnava::Action::"POST /api/pickups/:id/collect",
    Punarnava::Action::"POST /api/pickups/:id/deliver"
  ],
  resource
)
when { principal.status == "active" };

@id("role-recycler")
permit (
  principal in Punarnava::Role::"recycler",
  action in [
    Punarnava::Action::"GET /api/inventory",
    Punarnava::Action::"POST /api/passports/:pid/harvest",
    Punarnava::Action::"POST /api/passports/:pid/recycle",
    Punarnava::Action::"GET /api/pickups/requested",
    Punarnava::Action::"GET /api/recycler/incoming",
    Punarnava::Action::"POST /api/pickups/:id/confirm",
    Punarnava::Action::"POST /api/listings",
    Punarnava::Action::"GET /api/listings/mine",
    Punarnava::Action::"POST /api/listings/:id/sold"
  ],
  resource
)
when { principal.status == "active" };

@id("role-brand")
permit (
  principal in Punarnava::Role::"brand",
  action in [
    Punarnava::Action::"GET /api/insights/brands",
    Punarnava::Action::"GET /api/insights/models",
    Punarnava::Action::"GET /api/insights/report",
    Punarnava::Action::"GET /api/insights/pdf",
    Punarnava::Action::"POST /api/assist/design"
  ],
  resource
)
when { principal.status == "active" };

@id("role-customer")
permit (
  principal in Punarnava::Role::"customer",
  action in [
    Punarnava::Action::"GET /api/customer/home",
    Punarnava::Action::"POST /api/customer/requests"
  ],
  resource
)
when { principal.status == "active" };

@id("admin")
permit (principal in Punarnava::Role::"admin", action, resource);

// Suspended accounts keep their own profile and inbox, and what anyone can see without signing in.
@id("suspended")
forbid (principal, action, resource)
when {
  principal.status == "suspended" &&
  !(action in [
    Punarnava::Action::"GET /public/catalog",
    Punarnava::Action::"GET /public/impact",
    Punarnava::Action::"GET /public/passport/:pid",
    Punarnava::Action::"GET /public/owner/:jobId",
    Punarnava::Action::"POST /public/owner/:jobId/decision",
    Punarnava::Action::"POST /public/owner/:jobId/confirm",
    Punarnava::Action::"POST /public/owner/:jobId/followup",
    Punarnava::Action::"POST /public/owner/:jobId/green",
    Punarnava::Action::"GET /public/market",
    Punarnava::Action::"GET /public/market/:id",
    Punarnava::Action::"POST /public/market/:id/interest",
    Punarnava::Action::"GET /public/scores",
    Punarnava::Action::"GET /public/rates",
    Punarnava::Action::"GET /api/me",
    Punarnava::Action::"PUT /api/me",
    Punarnava::Action::"GET /api/notifications",
    Punarnava::Action::"POST /api/notifications/read",
    Punarnava::Action::"POST /public/tts",
    Punarnava::Action::"POST /public/owner/:jobId/uploads",
    Punarnava::Action::"POST /public/owner/:jobId/stt",
    Punarnava::Action::"GET /public/owner/:jobId/stt/:jobName",
    Punarnava::Action::"GET /public/rewards/rules",
    Punarnava::Action::"POST /public/requests/match",
    Punarnava::Action::"POST /public/requests/uploads",
    Punarnava::Action::"POST /public/requests",
    Punarnava::Action::"GET /public/requests/:id",
    Punarnava::Action::"POST /public/requests/:id/cancel",
    Punarnava::Action::"GET /public/green/:cid",
    Punarnava::Action::"POST /public/green/:cid/read",
    Punarnava::Action::"GET /public/search"
  ])
};

// A brand user only ever sees their own brand, whatever brand a request names.
@id("brand-scope")
forbid (
  principal in Punarnava::Role::"brand",
  action in [
    Punarnava::Action::"GET /api/insights/brands",
    Punarnava::Action::"GET /api/insights/models",
    Punarnava::Action::"GET /api/insights/report",
    Punarnava::Action::"GET /api/insights/pdf",
    Punarnava::Action::"POST /api/assist/design"
  ],
  resource
)
when { context.brand != "" && context.brand != principal.brandId };

// Only registered refurbishers list products on ReLife; only registered recyclers confirm deliveries.
@id("refurbishers-list")
forbid (principal, action == Punarnava::Action::"POST /api/listings", resource)
unless { principal.orgType == "refurbisher" || principal.orgType == "both" || principal in Punarnava::Role::"admin" };

@id("recyclers-confirm")
forbid (principal, action == Punarnava::Action::"POST /api/pickups/:id/confirm", resource)
unless { principal.orgType == "recycler" || principal.orgType == "both" || principal in Punarnava::Role::"admin" };
